---
import { cn } from '@/utils/cn';
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'span'> {
  id?: string;
}

const { class: className, id, ...props } = Astro.props;
---

<span class={cn('block', className)} data-accordion-label id={id} {...props}>
  <slot />
</span>
