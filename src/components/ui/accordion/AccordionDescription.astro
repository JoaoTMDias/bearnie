---
import { cn } from '@/utils/cn';
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'span'> {
  id?: string;
}

const { class: className, id, ...props } = Astro.props;
---

<span
  class={cn('block text-sm font-normal text-muted-foreground', className)}
  data-accordion-description
  id={id}
  {...props}
>
  <slot />
</span>
